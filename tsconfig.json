{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "webworker"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "components/BaseLayout/index.jsx",
    "components/BaseLayout/styles.js",
    "components/Calendar/index.jsx",
    "components/Calendar/styles.js",
    "pages/Main/index.jsx",
    "pages/_app.jsx",
    "pages/_document.jsx",
    "pages/index.jsx",
    "pages/schedule.jsx"
  ],
  "exclude": [
    "node_modules"
  ]
}